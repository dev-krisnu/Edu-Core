# EduCore Environment — copy to .env and fill in your values
APP_BASE_URL=

# If auto-detect fails, set your folder, e.g. APP_BASE_URL=/educore

DB_HOST=localhost
DB_NAME=educore
DB_USER=root
DB_PASSWORD=

# Google Gemini (free tier) — https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Token-saving settings (lower = fewer tokens per request)
AI_MAX_TOKENS=512
AI_TEMPERATURE=0.5
AI_CACHE_TTL=3600
